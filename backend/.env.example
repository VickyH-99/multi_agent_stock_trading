# ============================================================
# Stock Agent V1 - Environment Configuration
# ============================================================

# Server
STOCK_AGENT_HOST=0.0.0.0
STOCK_AGENT_PORT=8000
STOCK_AGENT_DEBUG=false
STOCK_AGENT_LOG_LEVEL=INFO

# Redis Cache (optional - falls back to in-memory if not set)
STOCK_AGENT_REDIS_URL=redis://localhost:6379/0
STOCK_AGENT_USE_REDIS=false

# Tushare (optional free tier)
STOCK_AGENT_TUSHARE_TOKEN=

# Cache TTLs (seconds)
STOCK_AGENT_REALTIME_CACHE_TTL=10
STOCK_AGENT_QUOTE_CACHE_TTL=15
STOCK_AGENT_SECTOR_CACHE_TTL=30
STOCK_AGENT_CAPITAL_FLOW_CACHE_TTL=20
STOCK_AGENT_FUNDAMENTALS_CACHE_TTL=3600

# Data fetch timeouts
STOCK_AGENT_HTTP_TIMEOUT=8
STOCK_AGENT_RETRY_ATTEMPTS=3
STOCK_AGENT_RETRY_DELAY=1.0

# Auto-refresh interval options (seconds)
STOCK_AGENT_DEFAULT_REFRESH_INTERVAL=10

# Rate limiting
STOCK_AGENT_MAX_CONCURRENT_REQUESTS=10
STOCK_AGENT_REQUEST_QUEUE_SIZE=100

# CORS - frontend origins
STOCK_AGENT_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
